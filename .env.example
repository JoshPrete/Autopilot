# ============================================================
# Clubhouse Autopilot v1.2 - Environment Variables
# Copy to .env and fill with real credentials
# ============================================================

# Square POS
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_ENVIRONMENT=production
SQUARE_TERMINAL_DEVICE_ID=your_terminal_device_id
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.com/webhooks/square
SQUARE_SANDBOX_TEST_SOURCE_ID=cnon:card-nonce-ok

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+61400000000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clubhouse_autopilot

# Weather (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_LAT=-27.4005
WEATHER_LON=153.0590

# Site Configuration
SITE_TIMEZONE=Australia/Brisbane
MANAGER_PHONE=+61412000000

# Deputy Workforce Management (optional — roster/staffing integration)
# DEPUTY_BASE_URL=https://yourinstall.au.deputy.com
# DEPUTY_ACCESS_TOKEN=your_deputy_oauth_token

# Xero Accounting (optional — fail-quiet if not connected)
# XERO_CLIENT_ID=your_xero_oauth_client_id
# XERO_CLIENT_SECRET=your_xero_oauth_client_secret
# XERO_REDIRECT_URI=http://localhost:8000/api/xero/callback
# Required for encrypted token storage:
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AUTOPILOT_TOKEN_ENC_KEY=replace_with_generated_key
# Optional safety controls:
# ALLOW_AUTO_APPLY_PROPOSED_MAPPINGS=false
# MIN_CONFIDENCE_AUTO_APPLY=0.90
# MAX_COST_DELTA_PCT=40
# XERO_MAPPING_PROMPT_VERSION=xero-mapping-v2

# AI Chat (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Autopilot Tuning (optional - defaults in settings.py)
# RUSH_THRESHOLD_MULTIPLIER=1.3
# WALLY_TRIGGER_MILK_DRINKS=3
# RECENT_PATTERN_WEEKS=6
# YOY_YEARS_BACK=2
